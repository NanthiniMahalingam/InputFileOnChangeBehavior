{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug InputFileOnChange (HTTP)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/bin/Debug/net11.0/InputFileOnChange.dll",
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "launchSettingsProfile": "http",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      }
    }
  ]
}